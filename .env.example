QC_PORT=8090
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
YOLO_WORLD_MODEL=yolov8s-worldv2.pt
YOLO_DEVICE=0
# Chỉ cần đổi khi chạy ngoài Docker. Docker dùng named volumes ở /var/lib/model-qc.
# QC_MEDIA_ROOT=/path/to/media
# QC_MODEL_ROOT=/path/to/models
# QC_DATASET_ROOT=/path/to/datasets
POSTGRES_DB=model_qc
POSTGRES_USER=model_qc
POSTGRES_PASSWORD=model_qc_local
DATA_UPLOAD_MAX_NUMBER_FILES=50000
DATA_UPLOAD_MAX_NUMBER_FIELDS=100000
DATASET_MAX_ARCHIVE_FILES=2000000
# 2 TiB; giảm theo quota storage của môi trường production.
DATASET_MAX_EXTRACTED_BYTES=2199023255552
